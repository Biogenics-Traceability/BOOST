{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/Biogenics-Traceability/BOOST/schemas/geographic-data",
    "type": "object",
    "properties": {
      "@context": {
        "type": "object"
      },
      "@type": {
        "type": "string",
        "enum": [
          "GeographicData"
        ]
      },
      "@id": {
        "type": "string",
        "format": "uri"
      },
      "geographicDataId": {
        "type": "string",
        "pattern": "^GEO-[A-Z0-9-_]+$",
        "description": "Unique identifier for the geographic data"
      },
      "geoJsonData": {
        "type": "object",
        "description": "Valid GeoJSON object (Point, Polygon, LineString, etc.)",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Point",
              "Polygon",
              "LineString",
              "MultiPoint",
              "MultiPolygon",
              "MultiLineString",
              "GeometryCollection"
            ]
          },
          "coordinates": {
            "type": "array"
          },
          "properties": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "dataType": {
        "type": "string",
        "enum": [
          "harvest_site",
          "processing_location",
          "administrative_boundary",
          "supply_base_area",
          "skid_road",
          "forest_road",
          "mill_entrance"
        ],
        "description": "Type of geographic data"
      },
      "description": {
        "type": "string",
        "description": "Human-readable description of the geographic area"
      },
      "lastUpdated": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp of the most recent data update"
      },
      "coordinateSystem": {
        "type": "string",
        "description": "Coordinate reference system (e.g., WGS84, UTM Zone 10N)",
        "default": "WGS84"
      },
      "accuracy": {
        "type": "number",
        "description": "GPS accuracy in meters",
        "minimum": 0
      },
      "elevationM": {
        "type": "number",
        "description": "Elevation in meters above sea level"
      },
      "administrativeRegion": {
        "type": "string",
        "description": "Administrative region or jurisdiction"
      },
      "accessRestrictions": {
        "type": "string",
        "description": "Any access restrictions or special conditions"
      },
      "plotIdentifiers": {
        "type": "array",
        "description": "Identifiers under which this area is known to an external registry: an open plot identifier (FAO GeoID), a national cadastral or land-registry reference, a forest management unit code, or the area named in a harvest permit. Lets a harvest polygon carry the identifier that regulators and registries resolve, alongside its geometry.",
        "items": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "enum": ["fao_geoid", "national_cadastre", "forest_management_unit", "permit_area", "other"],
              "description": "Identifier scheme"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "description": "Identifier value as issued"
            },
            "registry": {
              "type": "string",
              "description": "Name or URI of the registry that resolves the identifier (e.g., FAO AgStack asset registry; a national cadastre)"
            }
          },
          "required": ["scheme", "value"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "@context",
      "@type",
      "@id",
      "geographicDataId",
      "geoJsonData",
      "dataType",
      "description"
    ],
    "title": "Geographic Data",
    "description": "GeographicData entity in BOOST data model"
  },
  "rules": {
    "and": [
      {
        "!!": {
          "var": "geographicDataId"
        }
      },
      {
        "!!": {
          "var": "geoJsonData"
        }
      },
      {
        "!!": {
          "var": "dataType"
        }
      },
      {
        "!!": {
          "var": "description"
        }
      },
      {
        "!!": {
          "var": "geoJsonData.type"
        }
      },
      {
        "!!": {
          "var": "geoJsonData.coordinates"
        }
      },
      {
        "if": [
          {
            "var": "accuracy"
          },
          {
            ">=": [
              {
                "var": "accuracy"
              },
              0
            ]
          },
          true
        ]
      },
      {
        "in": [
          {
            "var": "geoJsonData.type"
          },
          [
            "Point",
            "Polygon",
            "LineString",
            "MultiPoint",
            "MultiPolygon",
            "MultiLineString",
            "GeometryCollection"
          ]
        ]
      }
    ]
  },
  "boost_metadata": {
    "entity": {
      "name": "GeographicData",
      "primaryKey": "geographicDataId",
      "area": "geographic_tracking",
      "description": "📍 Geographic location data for entities"
    },
    "relationships": []
  }
}